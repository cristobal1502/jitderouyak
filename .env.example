# Copia este archivo como ".env" (mismo nivel que manage.py) y completa tus datos.
# El archivo .env NO se sube a GitHub (está en .gitignore).

# --- Django ---
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
# En AWS agrega la IP elástica y/o el dominio, separados por coma:
# ALLOWED_HOSTS=54.12.34.56,mi-dominio.cl
# CSRF_TRUSTED_ORIGINS=http://54.12.34.56,https://mi-dominio.cl

# --- Base de datos MySQL (valores típicos de XAMPP) ---
# DB_ENGINE=sqlite   # descomenta para usar SQLite en vez de MySQL
DB_NAME=sgr_municipal
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Correo (si EMAIL_HOST_PASSWORD queda vacío, los correos se imprimen en la terminal) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=tucuenta@gmail.com
EMAIL_HOST_PASSWORD=
